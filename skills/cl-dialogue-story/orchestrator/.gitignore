# Legacy local artifacts: retain exclusions; do not create new private files here.
# Use an external --config path and a private working-script path (see ../SKILL.md).

# Legacy config fallback: cloned voice IDs, character art paths, background clip
config.local.json

# Legacy prompt module — relocation requires an external-loader change first
prompts.local.mjs

# Character art (likenesses / copyrighted) — supplied per-user, kept private
assets/characters/

# Working scripts accumulate personal generated asset URLs + machine paths.
# Only the public template (example.dialogue.json) is tracked.
scripts/*.json
!scripts/example.dialogue.json
